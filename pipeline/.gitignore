# --- Secrets ---
.env

# --- Daten (rohe + abgeleitete Artefakte; liegen lokal + im Bucket, nicht im Git) ---
data/*
*.pmtiles
*.parquet
*.fgb
*.gpkg
*.geojson
*.geojson.gz
*.xlsx

# Ausnahme: das generierte Manifest gehört ins Deploy (klein, kein Datenblob)
!data/manifest.json

# Ausnahme: die zwei publizierten PMTiles einmalig ins Repo (GitHub-Pages-Hosting),
# bis sie auf Backblaze/tiles.vizsim.de liegen — dann Negationen wieder entfernen.
# data/* + *.pmtiles ignorieren sonst alles darunter; die Negationen müssen NACH
# beiden Regeln stehen, damit sie greifen (spätere Regel gewinnt).
!data/svz/
!data/svz/svz_de.pmtiles
!data/svz/svz_bast.pmtiles

# --- Python / uv ---
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# --- OS / Editor ---
.DS_Store
.idea/
.vscode/
